{
  "name": "@xochi/recipient",
  "version": "0.1.0-test.4",
  "private": true,
  "description": "Installable test artifact for the local Xochi OXDAI recipient CLI. No package publication.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "xochi-recipient": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "npm-shrinkwrap.json",
    "scripts/qualify-extracted-root.mjs",
    "scripts/seed-locked-cache.mjs",
    "scripts/verify-installed-closure.mjs"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b tsconfig.vendor.json && tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run && npm run test:closure && npm run test:release-preflight",
    "test:closure": "node test/release-closure.test.mjs",
    "test:release-preflight": "node test/release-immutability.test.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"test/**/*.mjs\" \"!src/core/**\" \"qualify/*.mjs\" \"scripts/*.mjs\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"test/**/*.mjs\" \"!src/core/**\" \"qualify/*.mjs\" \"scripts/*.mjs\" \"*.json\"",
    "dry-run": "node dist/cli.js plan",
    "prepack": "npm run build",
    "release:artifact": "node scripts/build-release.mjs",
    "release:preflight": "node scripts/verify-release-immutability.mjs",
    "build:broadcaster": "npm run build && bash scripts/build-broadcaster.sh",
    "smoke:no-plaintext-keys": "npm run build && node scripts/smoke-no-plaintext-keys.mjs"
  },
  "dependencies": {
    "@aztec-labs/accounts": "6.0.0",
    "@aztec-labs/aztec.js": "6.0.0",
    "@aztec-labs/blob-lib": "6.0.0",
    "@aztec-labs/constants": "6.0.0",
    "@aztec-labs/foundation": "6.0.0",
    "@aztec-labs/kv-store": "6.0.0",
    "@aztec-labs/protocol-contracts": "6.0.0",
    "@aztec-labs/pxe": "6.0.0",
    "@aztec-labs/stdlib": "6.0.0",
    "@aztec-labs/wallets": "6.0.0",
    "@hpke/core": "1.9.0",
    "@noble/hashes": "1.8.0",
    "@xochi/signer": "0.7.0",
    "viem": "2.57.1",
    "zod4": "npm:zod@4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "prettier": "~3.8.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
