{
  "name": "@xochi/sdk",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "browser": [
        "./dist/circuits-browser.d.ts"
      ],
      "node": [
        "./dist/circuits.d.ts"
      ],
      "provider": [
        "./dist/provider/index.d.ts"
      ],
      "tiers": [
        "./dist/tiers.d.ts"
      ],
      "scoring": [
        "./dist/scoring.d.ts"
      ],
      "constants": [
        "./dist/constants.d.ts"
      ],
      "abis": [
        "./dist/abis.d.ts"
      ],
      "oracle-lite": [
        "./dist/oracle-lite.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/circuits-browser.d.ts",
      "import": "./dist/circuits-browser.js",
      "default": "./dist/circuits-browser.js"
    },
    "./node": {
      "types": "./dist/circuits.d.ts",
      "import": "./dist/circuits.js",
      "default": "./dist/circuits.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "import": "./dist/provider/index.js",
      "default": "./dist/provider/index.js"
    },
    "./circuits/*": "./circuits/*",
    "./tiers": {
      "types": "./dist/tiers.d.ts",
      "import": "./dist/tiers.js",
      "default": "./dist/tiers.js"
    },
    "./scoring": {
      "types": "./dist/scoring.d.ts",
      "import": "./dist/scoring.js",
      "default": "./dist/scoring.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "default": "./dist/constants.js"
    },
    "./abis": {
      "types": "./dist/abis.d.ts",
      "import": "./dist/abis.js",
      "default": "./dist/abis.js"
    },
    "./oracle-lite": {
      "types": "./dist/oracle-lite.d.ts",
      "import": "./dist/oracle-lite.js",
      "default": "./dist/oracle-lite.js"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "circuits"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p daemon/tsconfig.json",
    "test": "vitest run",
    "drift-check": "vitest run --config vitest.drift.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"daemon/src/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"daemon/src/**/*.ts\" \"*.{json,md}\"",
    "daemon": "npm run build && node --experimental-strip-types daemon/src/index.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@aztec/bb.js": "4.0.0-nightly.20260120",
    "@noble/curves": "^1.9.0",
    "@noir-lang/noir_js": "1.0.0-beta.19"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "prettier": "^3.3.3",
    "typescript": "~5.6.2",
    "viem": "^2.21.0",
    "vitest": "^4.0.0"
  }
}
