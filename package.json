{
  "name": "xochi-sdk-workspace",
  "private": true,
  "description": "npm workspace root for the Xochi SDK monorepo; publishes nothing.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:workspaces",
    "typecheck": "npm run typecheck:workspaces",
    "test": "npm run test:workspaces",
    "format": "prettier --write \"*.{json,md}\"",
    "format:check": "prettier --check \"*.{json,md}\"",
    "build:workspaces": "npm run build -w @xochi/signer && npm run build --workspaces --if-present",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:sdk": "npm test -w @xochi/sdk",
    "test:integration": "npm run test:integration -w @xochi/sdk",
    "test:provider": "npm test -w @xochi/provider",
    "test:signer": "npm test -w @xochi/signer",
    "test:conformance": "npm run test:conformance -w @xochi/reference",
    "test:fee": "npm run test:fee -w @xochi/reference",
    "generate:conformance": "npm run generate:conformance -w @xochi/spec",
    "generate:fee": "npm run generate:fee -w @xochi/spec",
    "generate:solver-bid-v2": "npm run generate:solver-bid-v2 -w @xochi/spec",
    "generate:escrow": "npm run generate:escrow -w @xochi/spec",
    "generate:wire": "npm run generate:wire -w @xochi/spec --",
    "verify:version": "node scripts/verify-attestation-version.mjs",
    "verify:vectors": "node scripts/verify-attestation-vectors.mjs",
    "verify:spec-version": "node scripts/verify-spec-version.mjs",
    "verify:openapi": "node scripts/verify-openapi.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
