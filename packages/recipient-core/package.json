{
  "name": "@xochi/recipient-core",
  "version": "0.1.0",
  "description": "Platform-neutral Stealth on Aztec recipient core (account, sync, receipt, enrollment, spend, exit) behind storage, lock, crypto, artifact and attestation ports.",
  "homepage": "https://github.com/xochi-fi/xochi-sdk/tree/main/packages/recipient-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xochi-fi/xochi-sdk.git",
    "directory": "packages/recipient-core"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./attestation": {
      "types": "./dist/attestation/index.d.ts",
      "default": "./dist/attestation/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b src/oxide/vendor && tsc -p tsconfig.build.json",
    "typecheck": "tsc -b src/oxide/vendor && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"!src/oxide/vendor/**\"",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aztec-labs/accounts": "6.0.0",
    "@aztec-labs/aztec.js": "6.0.0",
    "@aztec-labs/blob-lib": "6.0.0",
    "@aztec-labs/constants": "6.0.0",
    "@aztec-labs/foundation": "6.0.0",
    "@aztec-labs/kv-store": "6.0.0",
    "@aztec-labs/pxe": "6.0.0",
    "@aztec-labs/stdlib": "6.0.0",
    "@aztec-labs/wallets": "6.0.0",
    "@hpke/core": "1.9.0",
    "@noble/hashes": "1.8.0",
    "@peculiar/x509": "1.14.3",
    "@xochi/signer": "0.8.0",
    "buffer": "6.0.3",
    "viem": "2.57.1",
    "zod4": "npm:zod@4.4.3"
  },
  "devDependencies": {
    "@aztec-labs/sqlite3mc-wasm": "6.0.0",
    "@types/node": "^22.15.17",
    "esbuild": "0.28.2",
    "playwright": "1.59.1",
    "prettier": "~3.8.3",
    "rolldown": "1.2.16",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
