{
  "name": "@xochi/spec",
  "version": "0.12.0",
  "description": "Xochi protocol spec, wire contract and byte-equality conformance vectors.",
  "keywords": [
    "xochi",
    "specification",
    "conformance",
    "eip-712",
    "openapi"
  ],
  "homepage": "https://github.com/xochi-fi/xochi-sdk/tree/main/packages/spec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xochi-fi/xochi-sdk.git",
    "directory": "packages/spec"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./*.md": "./*.md",
    "./conformance/*.json": "./conformance/*.json",
    "./erc8262/*.json": "./erc8262/*.json",
    "./fee/*.json": "./fee/*.json",
    "./wire/openapi.json": "./wire/openapi.json",
    "./wire/openapi.sha256": "./wire/openapi.sha256",
    "./wire/compare.mjs": "./wire/compare.mjs"
  },
  "files": [
    "SPEC.md",
    "SOLVER-RFC.md",
    "ESCROW-RFC.md",
    "conformance",
    "fee",
    "erc8262",
    "wire",
    "!wire/*.tmp",
    "!wire/generate.mjs",
    "!wire/format.mjs",
    "!conformance/*.ts",
    "!fee/*.ts",
    "!erc8262/*.ts",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "npm run format:check -- --write",
    "format:check": "prettier --check \"conformance/**/*.ts\" \"fee/**/*.ts\" \"erc8262/**/*.ts\" \"test/**/*.ts\" \"wire/**/*.mjs\" \"*.json\"",
    "generate:fee": "tsx fee/generate.ts",
    "generate:erc8262": "tsx erc8262/generate.ts",
    "generate:order-id": "tsx conformance/generate-order-id.ts",
    "generate:open-auth": "tsx conformance/generate-open-auth.ts",
    "generate:fill-salt": "tsx conformance/generate-fill-salt.ts",
    "generate:fill-auth": "tsx conformance/generate-fill-auth.ts",
    "generate:fill-attestation": "tsx conformance/generate-fill-attestation.ts",
    "generate:slash-attestation": "tsx conformance/generate-slash-attestation.ts",
    "generate:dest-blinding": "tsx conformance/generate-dest-blinding.ts",
    "generate:escrow": "npm run generate:order-id && npm run generate:open-auth && npm run generate:dest-blinding && npm run generate:fill-salt && npm run generate:fill-auth && npm run generate:fill-attestation && npm run generate:slash-attestation && npm run generate:fill-acceptance && npm run generate:xsp",
    "generate:wire": "node wire/generate.mjs",
    "generate:solver-bid-v2": "tsx conformance/generate-solver-bid-v2.ts",
    "generate:solver-registration": "tsx conformance/generate-solver-registration.ts",
    "generate:fill-acceptance": "tsx conformance/generate-fill-acceptance.ts",
    "generate:xsp": "tsx conformance/generate-xsp.ts",
    "generate:shielded": "tsx conformance/generate-shielded.ts && npm run generate:shielded-recipient && npm run generate:shielded-readiness",
    "generate:shielded-terms": "tsx conformance/generate-shielded-terms.ts",
    "generate:shielded-recipient": "tsx conformance/generate-shielded-recipient.ts",
    "generate:shielded-readiness": "tsx conformance/generate-shielded-readiness.ts",
    "crosscheck:aztec": "cd aztec-crosscheck && npm ci && npm run crosscheck",
    "generate:conformance": "tsx conformance/generate.ts",
    "generate": "npm run generate:conformance && npm run generate:fee && npm run generate:erc8262 && npm run generate:solver-bid-v2 && npm run generate:solver-registration && npm run generate:escrow && npm run generate:shielded && npm run generate:shielded-terms",
    "check:vectors": "npm run generate && git diff --exit-code -- 'conformance/*.json' 'fee/*.json' 'erc8262/*.json' && cd wire && printf '%s  openapi.json\\n' \"$(cat openapi.sha256)\" | shasum -a 256 -c -",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@xochi/client": "0.1.10",
    "@xochi/reference": "0.0.0",
    "@xochi/signer": "0.7.0",
    "@xochi/solver-sdk": "0.5.0",
    "ajv": "^8.20.0",
    "@zkpassport/poseidon2": "0.6.2",
    "ethers": "^6.17.0",
    "tsx": "^4.23.13"
  }
}
