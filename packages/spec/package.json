{
  "name": "@xochi/spec",
  "version": "0.8.0",
  "description": "Xochi protocol spec, served wire contract and byte-equality conformance vectors (Xochi intent, ERC-3009, Permit2, escrow, solver bids, fees)",
  "type": "module",
  "files": [
    "SPEC.md",
    "SOLVER-RFC.md",
    "ESCROW-RFC.md",
    "conformance",
    "fee",
    "wire",
    "!wire/*.tmp",
    "!wire/generate.mjs",
    "!wire/format.mjs",
    "!conformance/*.ts",
    "!fee/*.ts"
  ],
  "exports": {
    "./conformance/conformance.json": "./conformance/conformance.json",
    "./conformance/schema.json": "./conformance/schema.json",
    "./conformance/order-id.json": "./conformance/order-id.json",
    "./conformance/order-id.schema.json": "./conformance/order-id.schema.json",
    "./conformance/open-auth.json": "./conformance/open-auth.json",
    "./conformance/open-auth.schema.json": "./conformance/open-auth.schema.json",
    "./conformance/fill-salt.json": "./conformance/fill-salt.json",
    "./conformance/fill-salt.schema.json": "./conformance/fill-salt.schema.json",
    "./conformance/fill-auth.json": "./conformance/fill-auth.json",
    "./conformance/fill-auth.schema.json": "./conformance/fill-auth.schema.json",
    "./conformance/fill-attestation.json": "./conformance/fill-attestation.json",
    "./conformance/fill-attestation.schema.json": "./conformance/fill-attestation.schema.json",
    "./conformance/slash-attestation.json": "./conformance/slash-attestation.json",
    "./conformance/slash-attestation.schema.json": "./conformance/slash-attestation.schema.json",
    "./conformance/dest-blinding.json": "./conformance/dest-blinding.json",
    "./conformance/dest-blinding.schema.json": "./conformance/dest-blinding.schema.json",
    "./fee/vectors.json": "./fee/vectors.json",
    "./fee/schedule.json": "./fee/schedule.json",
    "./fee/schema.json": "./fee/schema.json",
    "./wire/openapi.json": "./wire/openapi.json",
    "./wire/openapi.sha256": "./wire/openapi.sha256",
    "./wire/compare.mjs": "./wire/compare.mjs",
    "./SPEC.md": "./SPEC.md",
    "./SOLVER-RFC.md": "./SOLVER-RFC.md",
    "./ESCROW-RFC.md": "./ESCROW-RFC.md",
    "./conformance/fill-acceptance.json": "./conformance/fill-acceptance.json",
    "./conformance/fill-acceptance.schema.json": "./conformance/fill-acceptance.schema.json",
    "./conformance/solver-bid-v2.json": "./conformance/solver-bid-v2.json",
    "./conformance/solver-bid-v2.schema.json": "./conformance/solver-bid-v2.schema.json",
    "./conformance/xsp.json": "./conformance/xsp.json",
    "./conformance/xsp.schema.json": "./conformance/xsp.schema.json"
  },
  "scripts": {
    "generate": "tsx conformance/generate.ts",
    "generate:fee": "tsx fee/generate.ts",
    "generate:order-id": "tsx conformance/generate-order-id.ts",
    "generate:open-auth": "tsx conformance/generate-open-auth.ts",
    "generate:fill-salt": "tsx conformance/generate-fill-salt.ts",
    "generate:fill-auth": "tsx conformance/generate-fill-auth.ts",
    "generate:fill-attestation": "tsx conformance/generate-fill-attestation.ts",
    "generate:slash-attestation": "tsx conformance/generate-slash-attestation.ts",
    "generate:dest-blinding": "tsx conformance/generate-dest-blinding.ts",
    "generate:escrow": "npm run generate:order-id && npm run generate:open-auth && npm run generate:dest-blinding && npm run generate:fill-salt && npm run generate:fill-auth && npm run generate:fill-attestation && npm run generate:slash-attestation && npm run generate:fill-acceptance && npm run generate:xsp",
    "typecheck": "tsc --noEmit",
    "generate:wire": "node wire/generate.mjs",
    "generate:solver-bid-v2": "tsx conformance/generate-solver-bid-v2.ts",
    "generate:fill-acceptance": "tsx conformance/generate-fill-acceptance.ts",
    "generate:xsp": "tsx conformance/generate-xsp.ts",
    "test": "vitest run"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xochi-fi/xochi-sdk.git",
    "directory": "packages/spec"
  },
  "homepage": "https://github.com/xochi-fi/xochi-sdk/tree/main/packages/spec#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@xochi/signer": "0.5.0",
    "ethers": "^6.17.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "@xochi/solver-sdk": "0.4.1",
    "@xochi/reference": "0.0.0",
    "vitest": "^4.1.11"
  }
}
