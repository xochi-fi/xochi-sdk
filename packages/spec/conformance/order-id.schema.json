{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riddler.axol.io/spec/conformance/order-id.schema.json",
  "title": "Riddler escrow order v2 vector set",
  "description": "Cross-implementation vectors for canonicalKey, destCommitment and orderId (ESCROW-RFC §2). Each vector's orderId is computed over its terms plus its own expected_dest_commitment. Reference: @xochi/signer; TypeScript, Elixir and Solidity are held to this file.",
  "type": "object",
  "required": [
    "typehashes",
    "vectors"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "typehashes": {
      "type": "object",
      "required": [
        "DEST_TYPEHASH",
        "ORDER_TYPEHASH"
      ],
      "additionalProperties": false,
      "properties": {
        "DEST_TYPEHASH": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "ORDER_TYPEHASH": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "why",
          "opening",
          "expected_recipient_key",
          "expected_to_token_key",
          "expected_intent_id_hash",
          "expected_dest_commitment",
          "terms",
          "expected_order_id"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "opening": {
            "type": "object",
            "required": [
              "recipient",
              "toToken",
              "toAmount",
              "blinding",
              "intentId"
            ],
            "additionalProperties": false,
            "properties": {
              "recipient": {
                "type": "string",
                "minLength": 1
              },
              "toToken": {
                "type": "string",
                "minLength": 1
              },
              "toAmount": {
                "description": "Base-10 digit string, so values above 2^53 survive JSON.",
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "blinding": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              },
              "intentId": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "DestOpening. recipient/toToken are EVM addresses (keyed by their 20 bytes) or any other string (keyed by keccak of UTF-8)."
          },
          "expected_recipient_key": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "expected_to_token_key": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "expected_intent_id_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "expected_dest_commitment": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "terms": {
            "type": "object",
            "required": [
              "depositor",
              "fromChainId",
              "fromToken",
              "fromAmount",
              "toChainId",
              "fillDeadline",
              "escrow"
            ],
            "additionalProperties": false,
            "properties": {
              "depositor": {
                "description": "20-byte hex; case is not significant.",
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "fromChainId": {
                "description": "Base-10 digit string, so values above 2^53 survive JSON.",
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "fromToken": {
                "description": "20-byte hex; case is not significant.",
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "fromAmount": {
                "description": "Base-10 digit string, so values above 2^53 survive JSON.",
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "toChainId": {
                "description": "Base-10 digit string, so values above 2^53 survive JSON.",
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "fillDeadline": {
                "description": "Base-10 digit string, so values above 2^53 survive JSON.",
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "escrow": {
                "description": "20-byte hex; case is not significant.",
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              }
            },
            "description": "OrderTerms without destCommitment, which is expected_dest_commitment."
          },
          "expected_order_id": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
