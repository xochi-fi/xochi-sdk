{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riddler.axol.io/spec/conformance/solver-bid-v2.schema.json",
  "title": "Riddler SolverBid v2 vector set",
  "description": "EIP-712 SolverBid(bytes32 orderId,string auctionId,string intentId,uint256 output,uint64 validUntilMs,uint64 minExclusiveMs) vectors, domain RiddlerSolver/2. signer_private_key values are PUBLIC TEST keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "primary_type",
    "types",
    "encode_type",
    "typehash",
    "domain_separator",
    "vectors"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "RiddlerSolver"
        },
        "version": {
          "const": "2"
        }
      }
    },
    "primary_type": {
      "const": "SolverBid"
    },
    "types": {
      "type": "object"
    },
    "encode_type": {
      "const": "SolverBid(bytes32 orderId,string auctionId,string intentId,uint256 output,uint64 validUntilMs,uint64 minExclusiveMs)"
    },
    "typehash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "domain_separator": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "vectors": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "why",
          "bid",
          "message",
          "expected_struct_hash",
          "expected_digest",
          "signer_private_key",
          "signer_address",
          "expected_signature"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string"
          },
          "bid": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "auctionId",
              "intentId",
              "orderId",
              "output",
              "validUntilMs",
              "minExclusiveMs",
              "solverId"
            ],
            "properties": {
              "orderId": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              },
              "auctionId": {
                "type": "string"
              },
              "intentId": {
                "type": "string"
              },
              "output": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "description": "Canonical decimal uint256 string."
              },
              "validUntilMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "uint64 in the struct; a bare JSON number on the wire, so bounded at 2^53-1."
              },
              "minExclusiveMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "uint64 in the struct; a bare JSON number on the wire, so bounded at 2^53-1."
              },
              "solverId": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$",
                "description": "20-byte hex; case is not significant."
              }
            },
            "description": "The POST /solver/bids body minus `signature` (carried as expected_signature)."
          },
          "message": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "orderId",
              "auctionId",
              "intentId",
              "output",
              "validUntilMs",
              "minExclusiveMs"
            ],
            "properties": {
              "orderId": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              },
              "auctionId": {
                "type": "string"
              },
              "intentId": {
                "type": "string"
              },
              "output": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "description": "Canonical decimal uint256 string."
              },
              "validUntilMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "uint64 in the struct; a bare JSON number on the wire, so bounded at 2^53-1."
              },
              "minExclusiveMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "uint64 in the struct; a bare JSON number on the wire, so bounded at 2^53-1."
              }
            }
          },
          "expected_struct_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "expected_digest": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "signer_private_key": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$",
            "description": "PUBLIC TEST key (Hardhat/Anvil). Never fund or register it."
          },
          "signer_address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "20-byte hex; case is not significant."
          },
          "expected_signature": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{130}$",
            "description": "65-byte r||s||v, low-s, lowercase hex."
          }
        }
      }
    }
  }
}
