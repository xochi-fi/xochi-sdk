{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riddler.axol.io/spec/conformance/fill-acceptance.schema.json",
  "title": "Riddler SolverBond v2 FillAcceptance vector set",
  "description": "EIP-712 FillAcceptance(bytes32 orderId,uint256 originChainId,address escrow,address filler,uint256 deadline,bytes32 fillAuth) vectors on RiddlerSolverBond/2, where fillAuth is the RiddlerFiller/1 EIP-712 digest of FillAuth(bytes32 fillId,address filler,address to,address token,uint256 amount,uint256 deadline). Signed by the filler. signer_private_key values are PUBLIC TEST keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "type",
    "typehash",
    "fill_auth_domain",
    "fill_auth_type",
    "fill_auth_typehash",
    "vectors"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "RiddlerSolverBond"
        },
        "version": {
          "const": "2"
        }
      }
    },
    "type": {
      "const": "FillAcceptance(bytes32 orderId,uint256 originChainId,address escrow,address filler,uint256 deadline,bytes32 fillAuth)"
    },
    "typehash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "fill_auth_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "RiddlerFiller"
        },
        "version": {
          "const": "1"
        }
      }
    },
    "fill_auth_type": {
      "const": "FillAuth(bytes32 fillId,address filler,address to,address token,uint256 amount,uint256 deadline)"
    },
    "fill_auth_typehash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "vectors": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "chainId",
          "verifyingContract",
          "fill_auth_domain",
          "fill_auth",
          "expected_fill_auth_digest",
          "acceptance",
          "expected_struct_hash",
          "expected_domain_separator",
          "expected_digest",
          "signer_private_key",
          "signer_address",
          "expected_signature"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "chainId": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Base-10 digit string, so values above 2^53 survive JSON."
          },
          "verifyingContract": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "20-byte hex; case is not significant."
          },
          "fill_auth_domain": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chainId",
              "verifyingContract"
            ],
            "properties": {
              "chainId": {
                "type": "string",
                "pattern": "^[0-9]+$",
                "description": "Base-10 digit string, so values above 2^53 survive JSON."
              },
              "verifyingContract": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$",
                "description": "20-byte hex; case is not significant."
              }
            },
            "description": "RiddlerFiller EIP-712 domain the FillAuth was issued on: chainId = destination (toChainId), verifyingContract = fillerContract."
          },
          "fill_auth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fillId",
              "filler",
              "to",
              "token",
              "amount",
              "deadline"
            ],
            "properties": {
              "fillId": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              },
              "filler": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$",
                "description": "20-byte hex; case is not significant."
              },
              "to": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$",
                "description": "20-byte hex; case is not significant."
              },
              "token": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$",
                "description": "20-byte hex; case is not significant."
              },
              "amount": {
                "type": "string",
                "pattern": "^[0-9]+$",
                "description": "Base-10 digit string, so values above 2^53 survive JSON."
              },
              "deadline": {
                "type": "string",
                "pattern": "^[0-9]+$",
                "description": "Base-10 digit string, so values above 2^53 survive JSON."
              }
            },
            "description": "The issued :winner FillAuth (RiddlerFiller FillAuth), the preimage of acceptance.fillAuth. Never published on-chain beside orderId."
          },
          "expected_fill_auth_digest": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "orderId",
              "originChainId",
              "escrow",
              "filler",
              "deadline",
              "fillAuth"
            ],
            "properties": {
              "orderId": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              },
              "originChainId": {
                "type": "string",
                "pattern": "^[0-9]+$",
                "description": "Base-10 digit string, so values above 2^53 survive JSON."
              },
              "escrow": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$",
                "description": "20-byte hex; case is not significant."
              },
              "filler": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$",
                "description": "20-byte hex; case is not significant."
              },
              "deadline": {
                "type": "string",
                "pattern": "^[0-9]+$",
                "description": "Base-10 digit string, so values above 2^53 survive JSON."
              },
              "fillAuth": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              }
            },
            "description": "SolverBond.FillAcceptance, fields in declaration order. fillAuth == expected_fill_auth_digest."
          },
          "expected_struct_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "expected_domain_separator": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "expected_digest": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "signer_private_key": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$",
            "description": "PUBLIC TEST key (Hardhat/Anvil). Never fund or register it."
          },
          "signer_address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "20-byte hex; case is not significant."
          },
          "expected_signature": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{130}$",
            "description": "65-byte r||s||v, low-s, lowercase hex."
          }
        }
      }
    }
  }
}
