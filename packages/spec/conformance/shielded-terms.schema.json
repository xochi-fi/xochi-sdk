{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xochi.fi/spec/conformance/shielded-terms.schema.json",
  "title": "Shielded settlement ShieldedTermsV1 typed-encoding vector set (PROPOSED)",
  "description": "PROPOSED typed encoding of ShieldedTermsV1 under the approved Domain (terms) (xochi shielded-execution.md §7; Riddler#1296): type strings, struct hashes, EIP-712 digests and source-wallet signatures (public test keys), plus single-field refusals. Generated with ethers primitives, independently of @xochi/signer and Riddler. uint values are decimal strings; bytes/addresses lowercase hex. Every vector differs from the baseline in one member; all digests are distinct. All values are fixtures.",
  "type": "object",
  "required": [
    "version",
    "status",
    "generator",
    "source",
    "constants",
    "domain",
    "types",
    "signerIsTestKey",
    "vectors",
    "refusals",
    "proposed"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "status": {
      "const": "PROPOSED"
    },
    "generator": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "constants": {
      "type": "object",
      "required": [
        "aztecFieldModulus",
        "amountMax",
        "domainVersion",
        "termsDomainName",
        "protocolVersion",
        "settlementType",
        "privacyLevel",
        "disclosureProfileA",
        "rails"
      ],
      "additionalProperties": false,
      "properties": {
        "aztecFieldModulus": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "amountMax": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "domainVersion": {
          "const": "1"
        },
        "termsDomainName": {
          "const": "Xochi Shielded Terms"
        },
        "protocolVersion": {
          "const": "xochi.shielded.terms.v1"
        },
        "settlementType": {
          "const": "shielded"
        },
        "privacyLevel": {
          "const": "private"
        },
        "disclosureProfileA": {
          "const": "recipient-private-public-amount-v1"
        },
        "rails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "domain": {
      "type": "object",
      "required": [
        "typeString",
        "typehash"
      ],
      "additionalProperties": false,
      "properties": {
        "typeString": {
          "type": "string"
        },
        "typehash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      }
    },
    "types": {
      "type": "object",
      "required": [
        "encodeType",
        "typehash",
        "source",
        "corridor",
        "destination"
      ],
      "additionalProperties": false,
      "properties": {
        "encodeType": {
          "type": "string"
        },
        "typehash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "source": {
          "type": "object",
          "required": [
            "typeString",
            "typehash"
          ],
          "additionalProperties": false,
          "properties": {
            "typeString": {
              "type": "string"
            },
            "typehash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            }
          }
        },
        "corridor": {
          "type": "object",
          "required": [
            "typeString",
            "typehash"
          ],
          "additionalProperties": false,
          "properties": {
            "typeString": {
              "type": "string"
            },
            "typehash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            }
          }
        },
        "destination": {
          "type": "object",
          "required": [
            "encodeType",
            "typehash"
          ],
          "additionalProperties": false,
          "properties": {
            "encodeType": {
              "type": "string"
            },
            "typehash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "signerIsTestKey": {
      "const": true
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "recipientBinding",
          "message",
          "domain",
          "domainSeparator",
          "networkIdentityDigest",
          "sourceHash",
          "corridorHash",
          "destinationHash",
          "structHash",
          "digest",
          "signer",
          "signature"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "recipientBinding": {
            "type": "object",
            "required": [
              "message",
              "digest"
            ],
            "additionalProperties": false,
            "properties": {
              "message": {
                "type": "object",
                "required": [
                  "sourceWallet",
                  "sourceChainId",
                  "aztecRecipient",
                  "aztecToken",
                  "descriptorDigest",
                  "corridorId",
                  "corridorRevision",
                  "manifestDigest",
                  "nonce",
                  "challengeExpiry",
                  "purpose"
                ],
                "additionalProperties": false,
                "properties": {
                  "sourceWallet": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{40}$"
                  },
                  "sourceChainId": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "aztecRecipient": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "aztecToken": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "descriptorDigest": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "corridorId": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "corridorRevision": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "manifestDigest": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "nonce": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "challengeExpiry": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "purpose": {
                    "const": "xochi.shielded.recipient-binding.v1"
                  }
                }
              },
              "digest": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              }
            }
          },
          "message": {
            "type": "object",
            "required": [
              "protocolVersion",
              "environment",
              "source",
              "destination",
              "refundAddress",
              "refundAmount",
              "collectBefore",
              "settlementServiceDeadline",
              "recipientBindingDigest",
              "policyRevision"
            ],
            "additionalProperties": false,
            "properties": {
              "protocolVersion": {
                "const": "xochi.shielded.terms.v1"
              },
              "environment": {
                "type": "string"
              },
              "source": {
                "type": "object",
                "required": [
                  "chainId",
                  "token",
                  "wallet",
                  "collector",
                  "amount"
                ],
                "additionalProperties": false,
                "properties": {
                  "chainId": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "token": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{40}$"
                  },
                  "wallet": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{40}$"
                  },
                  "collector": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{40}$"
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  }
                }
              },
              "destination": {
                "type": "object",
                "required": [
                  "settlementType",
                  "privacyLevel",
                  "disclosureProfile",
                  "rail",
                  "network",
                  "corridor",
                  "assetId",
                  "aztecToken",
                  "recipientBindingId",
                  "descriptorDigest",
                  "aztecRecipient",
                  "amount",
                  "feePayer"
                ],
                "additionalProperties": false,
                "properties": {
                  "settlementType": {
                    "const": "shielded"
                  },
                  "privacyLevel": {
                    "const": "private"
                  },
                  "disclosureProfile": {
                    "type": "string"
                  },
                  "rail": {
                    "enum": [
                      "a_tracer",
                      "b_panel"
                    ]
                  },
                  "network": {
                    "type": "object",
                    "required": [
                      "aztecChainId",
                      "protocolVersion",
                      "rollupAddress",
                      "l1ChainId",
                      "genesisOrNetworkDigest"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "aztecChainId": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)$"
                      },
                      "protocolVersion": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)$"
                      },
                      "rollupAddress": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{40}$"
                      },
                      "l1ChainId": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)$"
                      },
                      "genesisOrNetworkDigest": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{64}$"
                      }
                    }
                  },
                  "corridor": {
                    "type": "object",
                    "required": [
                      "corridorId",
                      "corridorRevision",
                      "manifestDigest"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "corridorId": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{64}$"
                      },
                      "corridorRevision": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)$"
                      },
                      "manifestDigest": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{64}$"
                      }
                    }
                  },
                  "assetId": {
                    "type": "string"
                  },
                  "aztecToken": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "recipientBindingId": {
                    "type": "string"
                  },
                  "descriptorDigest": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "aztecRecipient": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "feePayer": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  }
                }
              },
              "refundAddress": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{40}$"
              },
              "refundAmount": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "collectBefore": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "settlementServiceDeadline": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "recipientBindingDigest": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              },
              "policyRevision": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            }
          },
          "domain": {
            "type": "object",
            "required": [
              "name",
              "version",
              "chainId",
              "salt"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "chainId": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "salt": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              }
            }
          },
          "domainSeparator": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "networkIdentityDigest": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "corridorHash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "destinationHash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "structHash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "signer": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "signature": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{130}$"
          }
        }
      }
    },
    "refusals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "message",
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "message": {
            "type": "object"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "field"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "terms_version_unsupported",
                  "settlement_type_mismatch",
                  "privacy_level_unsupported",
                  "disclosure_profile_mismatch",
                  "rail_unknown",
                  "string_empty",
                  "environment_empty",
                  "deadline_order",
                  "not_bytes32",
                  "aztec_zero",
                  "aztec_out_of_field",
                  "amount_not_canonical",
                  "amount_zero",
                  "amount_over_max",
                  "not_evm_address",
                  "evm_address_zero",
                  "uint_out_of_range",
                  "chain_id_zero"
                ]
              },
              "field": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "proposed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
