{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riddler.axol.io/spec/conformance/dest-blinding.schema.json",
  "title": "Riddler escrow destination-blinding vector set",
  "description": "HMAC-SHA256(key, domain_tag || uint256_be32(fromChainId) || address_bytes20(escrow) || utf8(intentId)) (ESCROW-RFC §2.2). `key` is a PUBLIC TEST key.",
  "type": "object",
  "required": [
    "domain_tag",
    "key",
    "vectors"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "domain_tag": {
      "const": "riddler/dest-blinding/v1"
    },
    "key": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "fromChainId",
          "escrow",
          "intentId",
          "expected_blinding"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "fromChainId": {
            "description": "Base-10 digit string, so values above 2^53 survive JSON.",
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "escrow": {
            "description": "20-byte hex; case is not significant.",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "intentId": {
            "type": "string",
            "minLength": 1
          },
          "expected_blinding": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
