{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riddler.axol.io/spec/conformance/fill-auth.schema.json",
  "title": "Riddler RiddlerFiller FillAuth vector set",
  "description": "EIP-712 FillAuth(bytes32 fillId,address filler,address to,address token,uint256 amount,uint256 deadline) vectors (ESCROW-RFC \u00a79.4). signer_private_key values are PUBLIC TEST keys.",
  "type": "object",
  "required": [
    "domain",
    "typehash",
    "vectors"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "domain": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "RiddlerFiller"
        },
        "version": {
          "const": "1"
        }
      }
    },
    "typehash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "vectors": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "chainId",
          "verifyingContract",
          "fillId",
          "filler",
          "to",
          "token",
          "amount",
          "deadline",
          "expected_struct_hash",
          "expected_domain_separator",
          "expected_digest",
          "signer_private_key",
          "signer_address",
          "expected_signature"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "chainId": {
            "description": "Base-10 digit string, so values above 2^53 survive JSON.",
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "verifyingContract": {
            "description": "20-byte hex; case is not significant.",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "fillId": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "filler": {
            "description": "20-byte hex; case is not significant.",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "to": {
            "description": "20-byte hex; case is not significant.",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "token": {
            "description": "20-byte hex; case is not significant.",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "amount": {
            "description": "Base-10 digit string, so values above 2^53 survive JSON.",
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "deadline": {
            "description": "Base-10 digit string, so values above 2^53 survive JSON.",
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "expected_struct_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "expected_domain_separator": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "expected_digest": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "signer_private_key": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$",
            "description": "PUBLIC TEST key (Hardhat/Anvil). Never fund or register it."
          },
          "signer_address": {
            "description": "20-byte hex; case is not significant.",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "expected_signature": {
            "description": "65-byte r||s||v, low-s, lowercase hex.",
            "type": "string",
            "pattern": "^0x[0-9a-f]{130}$"
          }
        }
      }
    }
  }
}
