{
  "name": "@xochi/signer",
  "version": "0.5.1",
  "description": "Network-free EIP-712 signing and pre-sign checks for Xochi intents: ERC-3009, Permit2, ERC-5564, ERC-4337, escrow.",
  "keywords": [
    "xochi",
    "eip-712",
    "erc-3009",
    "permit2",
    "erc-5564",
    "erc-4337"
  ],
  "homepage": "https://github.com/xochi-fi/xochi-sdk/tree/main/packages/signer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xochi-fi/xochi-sdk.git",
    "directory": "packages/signer"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,ts}\"",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@noble/curves": "^1.2.0",
    "@zkpassport/poseidon2": "0.6.2",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "tsup": "^8.3.0"
  }
}
