{
  "name": "@xochi/signer",
  "version": "0.5.0",
  "description": "Network-free EIP-712 / stealth signing primitives for Xochi intents (ERC-3009, Permit2, Xochi, ERC-5564 stealth, escrow)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,ts}\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xochi-fi/xochi-sdk.git",
    "directory": "packages/signer"
  },
  "homepage": "https://github.com/xochi-fi/xochi-sdk/tree/main/packages/signer#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@noble/curves": "^1.2.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "fast-check": "^4.9.0"
  }
}
