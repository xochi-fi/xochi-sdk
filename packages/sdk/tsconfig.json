{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@xochi/provider": ["../provider/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
