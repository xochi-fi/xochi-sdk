{
  "name": "@xochi/sdk",
  "version": "0.5.0",
  "description": "Generate and verify ERC-8262 zero-knowledge compliance proofs, EVM-verifiable.",
  "keywords": [
    "erc-8262",
    "zero-knowledge",
    "zk-proof",
    "noir",
    "compliance",
    "xochi"
  ],
  "homepage": "https://github.com/xochi-fi/xochi-sdk/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xochi-fi/xochi-sdk.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "browser": [
        "./dist/circuits-browser.d.ts"
      ],
      "node": [
        "./dist/circuits.d.ts"
      ],
      "tiers": [
        "./dist/tiers.d.ts"
      ],
      "scoring": [
        "./dist/scoring.d.ts"
      ],
      "constants": [
        "./dist/constants.d.ts"
      ],
      "abis": [
        "./dist/abis.d.ts"
      ],
      "oracle-lite": [
        "./dist/oracle-lite.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/circuits-browser.d.ts",
      "import": "./dist/circuits-browser.js",
      "default": "./dist/circuits-browser.js"
    },
    "./node": {
      "types": "./dist/circuits.d.ts",
      "import": "./dist/circuits.js",
      "default": "./dist/circuits.js"
    },
    "./circuits/*": "./circuits/*",
    "./tiers": {
      "types": "./dist/tiers.d.ts",
      "import": "./dist/tiers.js",
      "default": "./dist/tiers.js"
    },
    "./scoring": {
      "types": "./dist/scoring.d.ts",
      "import": "./dist/scoring.js",
      "default": "./dist/scoring.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "default": "./dist/constants.js"
    },
    "./abis": {
      "types": "./dist/abis.d.ts",
      "import": "./dist/abis.js",
      "default": "./dist/abis.js"
    },
    "./oracle-lite": {
      "types": "./dist/oracle-lite.d.ts",
      "import": "./dist/oracle-lite.js",
      "default": "./dist/oracle-lite.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "circuits",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"docs/**/*.md\" \"*.{json,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"docs/**/*.md\" \"*.{json,md,ts}\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aztec/bb.js": "4.0.0-nightly.20260120",
    "@noir-lang/noir_js": "1.0.0-beta.19"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@xochi/provider": "0.1.0",
    "@xochi/spec": "0.11.0",
    "viem": "^2.21.0"
  }
}
