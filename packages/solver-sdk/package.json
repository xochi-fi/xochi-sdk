{
  "name": "@xochi/solver-sdk",
  "version": "0.4.1",
  "description": "Maker-side SDK for the Riddler sealed-bid RFQ (Solver RFC): discovery -> bid -> award -> fill. Scaffold -- the /solver/* surface is PROPOSED, not yet served.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example:solver": "tsx examples/reference-solver.ts",
    "example:escrow": "tsx examples/escrow-solver.ts"
  },
  "keywords": [
    "xochi",
    "solver",
    "rfq",
    "sealed-bid",
    "dark-pool",
    "cross-chain"
  ],
  "author": "Axol (https://axol.io)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xochi-fi/xochi-sdk.git",
    "directory": "packages/solver-sdk"
  },
  "dependencies": {
    "@xochi/signer": "^0.5.0",
    "ethers": "^6.17.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "fast-check": "^4.9.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "homepage": "https://github.com/xochi-fi/xochi-sdk/tree/main/packages/solver-sdk#readme"
}
