{
  "extends": "../../tsconfig.base.json",
  // `test/**` is included so `npm run typecheck` covers the suite: vitest does
  // not typecheck, so a test referencing a field the wire types no longer carry
  // used to pass CI and only fail against a live venue.
  "include": ["src/**/*.ts", "examples/**/*.ts", "test/**/*.ts"]
}
