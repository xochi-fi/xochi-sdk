{
  // Typecheck for sources and tests. The two build configs emit, with no Node
  // types: the library runs in a browser page.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2024.Promise", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vitest.config.ts"]
}
