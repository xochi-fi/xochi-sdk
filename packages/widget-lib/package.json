{
  "name": "@xochi/widget-lib",
  "version": "0.2.0",
  "description": "Embed the Xochi swap widget: iframe, EIP-1193 wallet bridge, auto-resize, trade events.",
  "keywords": [
    "xochi",
    "swap",
    "widget",
    "iframe",
    "eip-1193"
  ],
  "homepage": "https://github.com/xochi-fi/xochi-sdk/tree/main/packages/widget-lib#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xochi-fi/xochi-sdk.git",
    "directory": "packages/widget-lib"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.esm.json && tsc -p tsconfig.build.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.esm.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,ts}\"",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
