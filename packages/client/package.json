{
  "name": "@xochi/client",
  "version": "0.1.1",
  "description": "Xochi trade API client: transport, trade state machine, pre-sign fund-safety checks.",
  "keywords": [
    "xochi",
    "swap",
    "intents",
    "cross-chain",
    "eip-712"
  ],
  "homepage": "https://github.com/xochi-fi/xochi-sdk/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xochi-fi/xochi-sdk.git",
    "directory": "packages/client"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.esm.json && tsc -p tsconfig.build.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.machine.json",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,ts}\"",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@xochi/signer": "^0.5.1",
    "viem": "^2.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "fast-check": "^4.7.0"
  }
}
