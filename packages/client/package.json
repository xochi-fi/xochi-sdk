{
  "name": "@xochi/client",
  "version": "0.1.13",
  "description": "Xochi trade API client: transport, trade state machine, pre-sign fund-safety checks.",
  "keywords": [
    "xochi",
    "swap",
    "intents",
    "cross-chain",
    "eip-712"
  ],
  "homepage": "https://github.com/xochi-fi/xochi-sdk/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xochi-fi/xochi-sdk.git",
    "directory": "packages/client"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./ramp/*.json": "./ramp/*.json",
    "./ramp/README.md": "./ramp/README.md",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "ramp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-dual.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.machine.json",
    "test": "vitest run",
    "generate:ramp": "node --experimental-strip-types scripts/generate-ramp-contract.mjs",
    "format": "npm run format:check -- --write",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,ts}\"",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@xochi/signer": "^0.8.0",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "fast-check": "^4.9.0"
  }
}
